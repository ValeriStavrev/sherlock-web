# Donation link. Leave blank to hide the button.
DONATE_URL=https://buymeacoffee.com/valeri123

# Scanner/resource limits.
MAX_JOBS=2
RATE_LIMIT_COUNT=5
RATE_LIMIT_WINDOW=60
SHERLOCK_TIMEOUT=4
SHERLOCK_FAST_TIMEOUT=4
SHERLOCK_FULL_TIMEOUT=4
SHERLOCK_SAFETY_SECONDS=100
SOCIALSCAN_TIMEOUT=20
XON_TIMEOUT=12
HIBP_TIMEOUT=12
PORT=5000
WAITRESS_THREADS=8

# Optional. HIBP is NOT required for email scanning.
# If configured, the official HIBP API is queried for exact breach names.
HIBP_API_KEY=
